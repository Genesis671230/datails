{
  "openapi": "3.1.0",
  "info": {
    "title": "Datails Backend",
    "description": "Case-centric Operational AI Workspace for digital asset investigations and compliance.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/bootstrap": {
      "post": {
        "tags": [
          "workspaces"
        ],
        "summary": "Bootstrap",
        "operationId": "bootstrap_api_v1_workspaces_bootstrap_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceContextResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/me": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "Me",
        "operationId": "me_api_v1_workspaces_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceContextResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BootstrapRequest": {
        "properties": {
          "tenant_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Name"
          }
        },
        "type": "object",
        "title": "BootstrapRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TenantOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "plan": {
            "type": "string",
            "title": "Plan"
          },
          "region": {
            "type": "string",
            "title": "Region"
          },
          "learning_capture_enabled": {
            "type": "boolean",
            "title": "Learning Capture Enabled"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "plan",
          "region",
          "learning_capture_enabled"
        ],
        "title": "TenantOut"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "role"
        ],
        "title": "UserOut"
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "owner",
          "investigator",
          "analyst",
          "viewer"
        ],
        "title": "UserRole",
        "description": "Minimal Phase 1 roles (02 Block A)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkspaceContextResponse": {
        "properties": {
          "tenant": {
            "$ref": "#/components/schemas/TenantOut"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          },
          "workspace": {
            "$ref": "#/components/schemas/WorkspaceOut"
          },
          "onboarding_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onboarding Status"
          }
        },
        "type": "object",
        "required": [
          "tenant",
          "user",
          "workspace",
          "onboarding_status"
        ],
        "title": "WorkspaceContextResponse"
      },
      "WorkspaceOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "workspace_type": {
            "type": "string",
            "title": "Workspace Type"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "workspace_type",
          "is_default",
          "created_at"
        ],
        "title": "WorkspaceOut"
      }
    }
  }
}
